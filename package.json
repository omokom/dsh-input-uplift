{
  "name": "@local/dsh-input-uplift",
  "version": "0.1.10",
  "private": true,
  "license": "MIT",
  "author": "omokom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omokom/dsh-input-uplift.git"
  },
  "homepage": "https://github.com/omokom/dsh-input-uplift",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test --test-isolation=none test/prompt.test.mjs test/contract.test.mjs test/compose.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run build && npm test && npm run check:bundle"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
